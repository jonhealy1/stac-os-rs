{
  "openapi": "3.0.3",
  "info": {
    "title": "stac-os-rs \u2014 STAC API with Multi-Tenant Catalogs",
    "description": "STAC API implementing the Multi-Tenant Catalogs extension, backed by OpenSearch. Transaction routes exist only when ENABLE_TRANSACTIONS_EXTENSIONS is set.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Landing page",
        "responses": {
          "200": {
            "description": "STAC Catalog root with conformsTo and navigation links"
          }
        }
      }
    },
    "/conformance": {
      "get": {
        "summary": "Conformance classes",
        "responses": {
          "200": {
            "description": "OGC conformance class URIs"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Item search (registry-wide)",
        "parameters": [
          {
            "name": "collections",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "intersects",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sortby",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Fields extension \u2014 comma-separated field paths, `-` prefix excludes. Nested paths and `*` wildcards supported, e.g. `id,properties.datetime,-geometry`"
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter extension \u2014 CQL2 expression in `filter-lang` (default cql2-text)"
          },
          {
            "name": "filter-lang",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "cql2-text",
                "cql2-json"
              ]
            }
          },
          {
            "name": "filter-crs",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON ItemCollection"
          }
        }
      },
      "post": {
        "summary": "Item search (registry-wide)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GeoJSON ItemCollection"
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "List all collections",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collections list"
          }
        }
      },
      "post": {
        "summary": "Create collection under root (transactions)",
        "responses": {
          "201": {
            "description": "Created"
          },
          "409": {
            "description": "ID exists"
          }
        }
      }
    },
    "/collections/{collection_id}": {
      "get": {
        "summary": "Collection document",
        "parameters": [
          {
            "name": "collection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "STAC Collection",
            "headers": {
              "ETag": {
                "description": "Strong entity tag: <primary_term>-<seq_no>-<index hash>, suffixed by content coding on compressed responses",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update collection (transactions)",
        "responses": {
          "200": {
            "description": "Updated",
            "headers": {
              "ETag": {
                "description": "Strong entity tag: <primary_term>-<seq_no>-<index hash>, suffixed by content coding on compressed responses",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "ID mismatch"
          },
          "404": {
            "description": "Not found"
          },
          "412": {
            "description": "Precondition Failed \u2014 If-Match did not match the current resource version"
          },
          "428": {
            "description": "Precondition Required \u2014 the deployment requires If-Match on writes"
          }
        },
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Write only if the supplied strong tag(s) match the current version \u2014 412 on mismatch, 428 when the deployment requires the header and it is absent"
          }
        ]
      },
      "delete": {
        "summary": "Delete collection and its items (transactions)",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          },
          "412": {
            "description": "Precondition Failed \u2014 If-Match did not match the current resource version"
          },
          "428": {
            "description": "Precondition Required \u2014 the deployment requires If-Match on writes"
          }
        },
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Write only if the supplied strong tag(s) match the current version \u2014 412 on mismatch, 428 when the deployment requires the header and it is absent"
          }
        ]
      },
      "patch": {
        "summary": "Patch collection (transactions)",
        "description": "JSON Merge Patch (`application/json` or `application/merge-patch+json`) or RFC 6902 JSON Patch (`application/json-patch+json`). Immutable `id` changes are rejected.",
        "responses": {
          "200": {
            "description": "Patched",
            "headers": {
              "ETag": {
                "description": "Strong entity tag: <primary_term>-<seq_no>-<index hash>, suffixed by content coding on compressed responses",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed patch or immutable-field change"
          },
          "404": {
            "description": "Not found"
          },
          "405": {
            "description": "Transactions disabled"
          },
          "412": {
            "description": "Precondition Failed \u2014 If-Match did not match the current resource version"
          },
          "428": {
            "description": "Precondition Required \u2014 the deployment requires If-Match on writes"
          }
        },
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Write only if the supplied strong tag(s) match the current version \u2014 412 on mismatch, 428 when the deployment requires the header and it is absent"
          }
        ]
      }
    },
