        }
      },
      "patch": {
        "summary": "Patch item (transactions)",
        "description": "JSON Merge Patch (`application/json` or `application/merge-patch+json`) or RFC 6902 JSON Patch (`application/json-patch+json`). Immutable `id`/`collection` changes are rejected.",
