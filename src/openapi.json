          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "2D/3D bbox; xmin > xmax crosses the antimeridian"
          },
          "intersects": {
            "type": "object",
            "description": "GeoJSON geometry"
          },
          "datetime": {
            "type": "string",
            "description": "RFC3339 instant or interval"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "sortby": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              }
            }
          },
          "fields": {
            "$ref": "#/components/schemas/Fields"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "Query extension \u2014 {property: {op: value}} with eq/ne/neq/gt/gte/lt/lte/in/contains"
          },
          "filter": {
            "description": "Filter extension \u2014 CQL2 expression object (cql2-json) or string (cql2-text, per filter-lang)",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "string"
              }
            ]
          },
          "filter-lang": {
            "type": "string",
            "enum": [
              "cql2-json",
              "cql2-text"
            ],
            "default": "cql2-json"
          },
          "filter-crs": {
            "type": "string",
            "default": "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
          }
        }
      },
      "Fields": {
        "type": "object",
        "description": "STAC Fields extension \u2014 include/exclude field paths applied to returned items. Nested paths and `*` wildcards supported; if include matches nothing, items fall back to {id, collection}.",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  }
}
