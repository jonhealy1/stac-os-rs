    "/collections/{collection_id}/bulk_items": {
      "post": {
        "summary": "Bulk Item Transactions",
        "description": "Insert or upsert a set of items in one request. Reports per-item results.",
        "parameters": [
          {
            "$ref": "#/components/parameters/collection_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/item"
                    }
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "insert",
                      "upsert"
                    ],
                    "default": "insert"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-item results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "integer"
                    },
                    "success": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "msg": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "msg"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed bulk request"
          },
          "404": {
            "description": "Collection not found"
          },
          "428": {
            "description": "Precondition Required \u2014 the deployment requires If-Match on writes"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchBody": {
        "type": "object",
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "2D/3D bbox; xmin > xmax crosses the antimeridian"
          },
          "intersects": {
            "type": "object",
            "description": "GeoJSON geometry"
          },
          "datetime": {
            "type": "string",
            "description": "RFC3339 instant or interval"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "sortby": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              }
            }
          },
          "fields": {
            "$ref": "#/components/schemas/Fields"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "Query extension \u2014 {property: {op: value}} with eq/ne/neq/gt/gte/lt/lte/in/contains"
          },
          "filter": {
            "description": "Filter extension \u2014 CQL2 expression object (cql2-json) or string (cql2-text, per filter-lang)",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "string"
              }
            ]
          },
          "filter-lang": {
            "type": "string",
            "enum": [
              "cql2-json",
              "cql2-text"
            ],
            "default": "cql2-json"
          },
          "filter-crs": {
            "type": "string",
            "default": "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
          }
        }
      },
      "Fields": {
        "type": "object",
        "description": "STAC Fields extension \u2014 include/exclude field paths applied to returned items. Nested paths and `*` wildcards supported; if include matches nothing, items fall back to {id, collection}.",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "parameters": {
      "collection_id": {
        "name": "collection_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Collection identifier"
      }
    }
  }
